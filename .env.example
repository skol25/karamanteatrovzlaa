# --- Base de datos ---
# Namecheap / local: archivo SQLite (déjalo vacío para usar ./data/karamantea.db)
# Vercel: URL y token de Turso (turso.tech)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Servidor ---
PORT=3000
SITE_URL=https://entradas.karamantea.com
# Detrás de Nginx/Caddy con HTTPS (necesario para que funcionen los formularios):
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
BODY_SIZE_LIMIT=6M
DATA_DIR=./data

# --- Administración ---
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
ADMIN_EMAIL=taquilla@karamantea.com

# --- Correo (SMTP). Si se deja vacío, los correos solo se registran en /admin/correos ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Karamantea Teatro <taquilla@karamantea.com>"

# --- Datos para recibir pagos ---
PAGO_BANCO="Banco de Venezuela (0102)"
PAGO_TELEFONO=0414-000-0000
PAGO_RIF=J-40722213-9
PAGO_TITULAR="Karamantea Teatro"
PAGO_CUENTA=

# --- Reglas ---
HOLD_MINUTES=20
MAX_TICKETS=10
MAX_RATE_AGE_DAYS=4

# --- Tasa BCV ---
BCV_REFRESH_MINUTES=30
# El sitio del BCV suele enviar una cadena SSL incompleta. Lo correcto es descargar el
# certificado intermedio y apuntar BCV_CA_FILE a él. BCV_INSECURE_TLS=1 es el último recurso.
BCV_CA_FILE=
BCV_INSECURE_TLS=0
